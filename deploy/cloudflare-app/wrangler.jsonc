{
  // The VIGIL/LEARN single-page app, served from Cloudflare's edge as static assets.
  //
  // Assets-only: there is no `main`, because this Worker runs no code of its own. The app
  // talks to https://api.vtlvs.com (baked in at build time via VITE_WW_GATEWAY_URL), so
  // putting a server in front of it here would only add a hop that can fail.
  //
  // Build it with:
  //   cd web && VITE_WW_GATEWAY_URL=https://api.vtlvs.com npm run build
  // which writes to ../hermes_cli/web_dist — an outDir set in web/vite.config.ts, not the
  // conventional web/dist. Pointing this config at web/dist deploys a stale August build.
  "name": "vtlvs-app",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../hermes_cli/web_dist",
    // A React router owns the paths. Without this, a reload on /learn/calendar returns the
    // edge's 404 instead of the app, because no file of that name exists.
    "not_found_handling": "single-page-application"
  },
  // A custom domain, not a route: Cloudflare then owns the hostname end to end — it
  // creates the DNS record, issues the certificate, and sends every path to this Worker.
  // A route would need a DNS record to already exist and would only intercept matching
  // paths, which for a single-page app is every path anyway.
  "routes": [
    { "pattern": "app.vtlvs.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
