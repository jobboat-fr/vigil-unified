{
  "uid": "vtlvs-securite-api",
  "title": "VTLVS — sécurité et API",
  "tags": ["vtlvs"],
  "timezone": "Europe/Paris",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "timeseries", "title": "Événements de sécurité (5 min)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki-vtlvs"},
      "targets": [{"refId": "A", "expr": "sum by (evenement) (count_over_time({evenement=~\"securite\\\\..+\"}[5m]))"}]
    },
    {
      "type": "timeseries", "title": "Réponses 5xx par service (5 min)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki-vtlvs"},
      "targets": [{"refId": "A", "expr": "sum by (service) (count_over_time({evenement=\"http.requete\"} | json | statut >= 500 [5m]))"}]
    },
    {
      "type": "timeseries", "title": "Temps de réponse p95 (ms)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki-vtlvs"},
      "targets": [{"refId": "A", "expr": "quantile_over_time(0.95, {evenement=\"http.requete\"} | json | unwrap duree_ms [5m]) by (service)"}]
    },
    {
      "type": "timeseries", "title": "Refus 401 / 403 / 429 (5 min)", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki-vtlvs"},
      "targets": [{"refId": "A", "expr": "sum by (statut) (count_over_time({evenement=\"http.requete\"} | json | statut=~\"401|403|429\" [5m]))"}]
    },
    {
      "type": "logs", "title": "Journal de sécurité", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki-vtlvs"},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{niveau=~\"warning|error|critical\"}"}]
    },
    {
      "type": "logs", "title": "Agents : requêtes et délégations", "gridPos": {"x": 0, "y": 26, "w": 24, "h": 10},
      "datasource": {"type": "loki", "uid": "loki-vtlvs"},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{evenement=~\"agent\\\\..+|securite\\\\.delegation.+|securite\\\\.agent.+\"}"}]
    }
  ]
}
